+.optimizerBody .optimizerSkillPlusFilterRow { display: grid; grid-template-columns: minmax(120px, 2fr) minmax(70px, 1fr) minmax(70px, 1fr); gap: 8px; }
+.optimizerBody .optimizerSkillPlusFilterRow input, .optimizerBody .optimizerSkillPlusFilterRow select { width: 100%; min-width: 0; box-sizing: border-box; }
+.optimizerBody .optimizerButtons { margin: 18px 0; }
+@media(max-width: 700px) {
+  .optimizerBody .optimizerSkillPlusFilterRows { grid-template-columns: 1fr; }
+  .optimizerSetupPanel, .optimizerAdvanced, .optimizerCompactGuide { padding: 12px; }
+}
